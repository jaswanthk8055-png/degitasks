{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors teams.microsoft.com *.teams.microsoft.com *.skype.com *.microsoft.com"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOW-FROM https://teams.microsoft.com"
        }
      ]
    }
  ],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
